{
  "name": "alex-set-list-app",
  "private": true,
  "version": "0.0.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "seed": "node scripts/seedEmulator.mjs",
    "emulators": "firebase emulators:start --project demo-asla",
    "build": "vue-tsc -b && vite build",
    "build:beta": "vue-tsc -b && vite build --mode beta",
    "build:isla": "vue-tsc -b && vite build --mode isla",
    "deploy:beta": "node scripts/deployBeta.mjs",
    "deploy:isla": "npm run build:isla && firebase deploy --config firebase.isla.json --project ibis-setlist-app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worklet": "esbuild src/audio/soundtouchWorklet.js --bundle --format=iife --target=safari14 --outfile=public/soundtouch-worklet.js",
    "predev": "npm run build:worklet",
    "predev:test": "npm run build:worklet",
    "prebuild": "npm run build:worklet",
    "prebuild:beta": "npm run build:worklet",
    "prebuild:isla": "npm run build:worklet"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "dayjs": "^1.11.12",
    "firebase": "^10.12.4",
    "idb-keyval": "^6.2.1",
    "pdfjs-dist": "3",
    "pinia": "^2.1.7",
    "soundtouchjs": "^0.3.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-vuetify": "^2.0.3",
    "vue": "^3.5.41",
    "vue-easy-dnd": "^2.1.3",
    "vue-pdf-embed": "^2.0.4",
    "vue-router": "^4.4.0",
    "vuefire": "^3.1.24",
    "vuetify": "^3.6.13"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.4.11",
    "firebase-tools": "^15.22.4",
    "happy-dom": "^20.11.6",
    "pdf-lib": "^1.17.1",
    "sass": "^1.77.8",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.24"
  }
}
