rules_version = '2';

// Same split as the database, and from the same place: the role in users/{uid}. Storage
// rules can read Firestore, so the sheets, audio and stems follow the roles rather than
// being writable by anyone who is signed in.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
