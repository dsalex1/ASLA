rules_version = '2';

// The whole database is readable by any signed-in account; only an admin may write it.
//
// A role lives in users/{uid}, so an account without one of those documents can read but
// not write, and the app shows it no setlists. That makes the first admin a bootstrap
// problem: nobody may write the users collection until one exists, so create it from the
// Firebase console (a users/<uid> document with role: "admin").
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
