rules_version = '2';
// Emulator-only rules. Never deploy.
//
// The signed-in half mirrors rules/firestore.rules exactly, so the role split is what is
// actually exercised locally. The unauthenticated half is what lets the seed script
// (scripts/seedEmulator.mjs) write the first admin, which no signed-in client may do.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /{document=**} {
      allow read, write: if request.auth == null;
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
