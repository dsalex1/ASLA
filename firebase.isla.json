{
  "hosting": {
    "public": "dist-isla",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/__test-*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{index.html,sw.js,manifest.webmanifest}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "rules/firestore.rules"
  },
  "storage": {
    "bucket": "ibis-setlist-app.firebasestorage.app",
    "rules": "rules/storage.rules"
  }
}
