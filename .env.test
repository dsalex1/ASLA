# Emulator test environment (npm run dev:test).
# The demo- project id guarantees the SDK/emulators never contact production.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-asla.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-asla
VITE_FIREBASE_STORAGE_BUCKET=demo-asla.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:demo
VITE_FIREBASE_MEASUREMENT_ID=

VITE_ICON_BASE=logo
VITE_PRIMARY_COLOR="#38A700"
